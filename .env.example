# BO-MCP-UI Environment Configuration
# Copy this file to .env and customize for your deployment

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection URL (production)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://bo_user:bo_password@localhost:5432/bo_mcp

# Enable SQL query logging (set to "true" for debugging)
SQL_ECHO=false

# =============================================================================
# PostgreSQL Settings (for docker-compose)
# =============================================================================

POSTGRES_USER=bo_user
POSTGRES_PASSWORD=bo_password
POSTGRES_DB=bo_mcp

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Frontend Configuration
# =============================================================================

# API URL as seen from the frontend container (Docker internal network)
VITE_API_URL=http://api:8000

# =============================================================================
# Development Settings
# =============================================================================

# Development API key (for local testing only - do not use in production!)
# DEV_API_KEY=dev-api-key-12345
