# BO-MCP Environment Configuration
# Copy this file to .env and customize for your deployment

# =============================================================================
# Database Configuration
# =============================================================================

# Enable SQL query logging (set to "true" for debugging)
SQL_ECHO=false

# =============================================================================
# PostgreSQL Settings (for docker-compose)
# =============================================================================

POSTGRES_USER=bo_user
POSTGRES_PASSWORD=bo_password
POSTGRES_DB=bo_mcp

# =============================================================================
# Backend Configuration
# =============================================================================

# Default BO backend for new campaigns when backend="auto" (per-campaign override available)
# Options: "botorch" (default), "baybe"
BO_BACKEND=botorch

# Log level: DEBUG, INFO, WARNING, ERROR
BO_MCP_LOG_LEVEL=INFO

# =============================================================================
# Authentication (development / eval only)
# =============================================================================

# The MCP transport carries no per-request authentication principal yet, so the
# mutating tools (bo_create_campaign / bo_submit_results / bo_upload_results_file)
# resolve the campaign owner internally instead of accepting a database user id
# from the agent. DEV_AUTH bootstraps a shared development user for them to
# resolve to; without it those tools return a missing-identity error.
#
# docker-compose.yml enables DEV_AUTH for the mcp/api containers by default, so
# the bundled stack works out of the box — you do not need to set it here. Only
# uncomment it when running the server directly on the host (outside Docker).
# NOTE: pydantic-settings reads this .env, so an uncommented DEV_AUTH also applies
# to local `pytest` runs — leave it commented unless you really need it.
#
# DEVELOPMENT/EVAL ONLY — the shared user's API key lives in source. There is no
# production MCP auth path yet (see resolve_mcp_user); DEV_AUTH=1 is refused at
# startup when API_ENV=production so it can never ship to prod.
#
# REST / OpenAPI clients (e.g. eval scripts) authenticate as that shared user by
# sending the dev API key (the DEV_API_KEY constant) in the X-API-Key header.
# There is no BO_MCP_API_KEY variable in this repo — the server only checks the
# X-API-Key header, so set that on the client rather than any env var.
# DEV_AUTH=1
# API_ENV=development

# =============================================================================
# MCP Server Configuration
# =============================================================================

# Extra allowed Host headers for SSE transport (comma-separated)
# Default allows localhost, 127.0.0.1, [::1], and the Docker service name "mcp"
# MCP_ALLOWED_HOSTS=proxy:*,gateway:*

# Extra allowed Origins for CORS (comma-separated)
# MCP_ALLOWED_ORIGINS=https://your-domain.com

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Docker Compose Network / Port Configuration
# =============================================================================

# External Docker network used by docker-compose.yml.
# The slot launcher overrides this with akg4pyscf-gpu-s<slot>-net so BO-MCP can
# join the matching gpu4pyscf development stack.
BO_MCP_NETWORK_NAME=bo-mcp-network

# Host ports bound by docker-compose.yml. The slot launcher shifts these by
# slot * 100 while keeping container ports stable for Docker service discovery.
BO_MCP_FRONTEND_PORT=3001
BO_MCP_API_PORT=8000
BO_MCP_SSE_PORT=8001

# =============================================================================
# Frontend Configuration
# =============================================================================

# API URL as seen from the frontend container (Docker internal network)
VITE_API_URL=http://api:8000

# =============================================================================
# GPU Configuration (optional)
# =============================================================================

# Force compute device: cuda, mps, cpu (auto-detected by default)
# BO_ENGINE_DEVICE=cuda

# Disable GPU acceleration entirely
# BO_ENGINE_DISABLE_GPU=1
