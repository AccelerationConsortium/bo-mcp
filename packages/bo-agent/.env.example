LOGFIRE_TOKEN=...
OPENAI_API_KEY=...

# Persistent memory root for the main agent and its subagents.
BO_AGENT_MEMORY_DIR=.deep/memory

# BO-MCP services exposed by the repository's local Docker Compose stack.
BO_MCP_API_URL=http://127.0.0.1:8000
BO_MCP_OPENAPI_URL=http://127.0.0.1:8000/openapi.json
BO_MCP_SSE_URL=http://127.0.0.1:8001/sse

# Development/evaluation only. This is the shared DEV_API_KEY seeded when the
# BO-MCP API starts with DEV_AUTH=1; use a real user API key outside local dev.
BO_MCP_API_KEY=dev-api-key-12345
